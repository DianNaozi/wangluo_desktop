{
  "name": "local-gallery",
  "version": "0.1.0",
  "description": "本地图库整理与浏览基础版",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "npm run typecheck:main && npm run typecheck:web",
    "typecheck:main": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "vue-tsc --noEmit",
    "preview": "electron-vite preview",
    "db:generate": "drizzle-kit generate",
    "pretest": "npm.cmd run build",
    "test": "vitest run"
  },
  "keywords": [
    "electron",
    "vue",
    "gallery",
    "local-media"
  ],
  "license": "MIT",
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "^3.1.0",
    "lucide-vue-next": "^0.468.0",
    "pinia": "^3.0.4",
    "reka-ui": "^2.8.2",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.4.0",
    "vue": "^3.5.42",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.63.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "drizzle-kit": "^0.31.10",
    "electron": "^44.1.1",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.2.5"
  }
}
